{
  "name": "glamflow",
  "private": true,
  "version": "0.3.0",
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@glamflow/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "validate:js": "node --check apps/api/src/server.js && node --check apps/worker/src/worker.js"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
